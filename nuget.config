<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Plenipo platform packages, vendored from the GitHub Release: they publish only to the
         GitHub Packages feed, which needs a PAT even for public repos. Vendoring is what keeps
         `dotnet restore` working on a bare clone. -->
    <add key="plenipo-local" value=".packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Dependency-confusion guard, not a formality: without the mapping, restore is free to prefer
       a public package that happens to be named Plenipo.Something. -->
  <packageSourceMapping>
    <packageSource key="plenipo-local">
      <package pattern="Plenipo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
