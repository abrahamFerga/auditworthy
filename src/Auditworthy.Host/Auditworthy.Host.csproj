<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- THE PRODUCT: a thin host on the Plenipo platform packages. One AddPlenipoPlatform() call
       brings auth, RBAC-before-the-model, multi-tenancy, approvals, append-only audit, chat
       (AG-UI + SignalR), document tools, OCR, RAG, jobs and the admin API; then the compliance
       module. Program.cs is the seam list and holds no logic. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>auditworthy-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Plenipo.AspNetCore" Version="0.1.0-alpha.28" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auditworthy.Compliance\Auditworthy.Compliance.csproj" />
  </ItemGroup>

</Project>
