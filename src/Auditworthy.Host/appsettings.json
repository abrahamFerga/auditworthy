{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Ai": {
    "Provider": "None",
    "Model": "gpt-4o-mini",
    "Endpoint": "",
    "Temperature": 0.0,
    "MaxOutputTokens": 4096,
    "SystemPrompt": "You are Auditworthy, a careful compliance and audit assistant. You never state that a control has changed status, or that an organisation is compliant or certified, before a human has approved the change."
  },
  "Auth": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "TenantClaim": "tenant",
    "DefaultRole": "compliance-reader"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "Files": {
    "Provider": "Local",
    "LocalRoot": "data/files",
    "MaxUploadBytes": 20971520
  },
  "Ocr": {
    "Provider": "None"
  },
  "Branding": {
    "ProductName": "Auditworthy"
  }
}
