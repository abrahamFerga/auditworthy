<Project Sdk="Microsoft.NET.Sdk">

  <!-- Boots the real host against a real Postgres via Testcontainers: platform + module migrations,
       real seeding, real job processor, real approval store. The Mock AI provider is the only
       stand-in, which is what lets rungs 3 and 4 run on a bare clone with no API key.
       Installed and owned by /deliver:install-runbook — re-running it reconciles this project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform's conformance kit, at the platform version: the Testcontainers host fixture,
         the AG-UI stream parser, the golden-eval runner and the spine/manifest/tenancy/red-team
         invariant packs, executed against THIS host. It also carries the harness dependencies that
         used to be pinned here one by one — Microsoft.AspNetCore.Mvc.Testing 10.0.10,
         Testcontainers.PostgreSql 4.15.0 and SSH.NET 2026.0.0 (past GHSA-q939-rpr3-3284, which is
         NU1903 at restore under this project's TreatWarningsAsErrors) — so a direct reference to any
         of them now only risks an NU1605 downgrade. -->
    <PackageReference Include="Plenipo.Testing" Version="$(PlenipoVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Auditworthy.Host\Auditworthy.Host.csproj" />
  </ItemGroup>

  <!-- Golden-conversation evals are data, not code, and must reach the test output or the theory
       runs zero cases while reporting green. The Content item is no longer declared here: the kit's
       buildTransitive/Plenipo.Testing.targets copies Evals\cases\*.json for every consumer (it
       Excludes @(Content), so declaring it in both is not an error — it is just a second place to
       forget). Opt out with <PlenipoTestingEvalCases>false</PlenipoTestingEvalCases>. -->


</Project>
