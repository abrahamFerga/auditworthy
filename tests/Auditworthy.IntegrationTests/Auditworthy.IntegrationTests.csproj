<Project Sdk="Microsoft.NET.Sdk">

  <!-- Boots the real host against a real Postgres via Testcontainers: platform + module migrations,
       real seeding, real job processor, real approval store. The Mock AI provider is the only
       stand-in, which is what lets rungs 3 and 4 run on a bare clone with no API key.
       Installed and owned by /deliver:install-runbook — re-running it reconciles this project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.6.0" />
    <!-- Transitive-only, and pinned deliberately: Testcontainers pulls SSH.NET for an SSH transport
         this project never uses, and every shipping Testcontainers version resolves it inside
         GHSA-q939-rpr3-3284's affected range (<= 2025.1.0; first patched 2026.0.0) — 4.9.0 still
         lands on 2025.1.0. Under this project's TreatWarningsAsErrors that advisory is NU1903 at
         *restore*, which takes rung 3 of the test ladder offline entirely. A direct reference
         raises the resolved version past the advisory and keeps the audit gate armed; suppressing
         NU1903 or dropping TreatWarningsAsErrors would trade the signal for the rung and lose both.
         Remove this line once Testcontainers ships a release that resolves SSH.NET >= 2026.0.0. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Auditworthy.Host\Auditworthy.Host.csproj" />
  </ItemGroup>

  <!-- Golden-conversation evals are data, not code: without this they never reach the test output
       and GoldenEvalTests runs zero cases while reporting green. -->
  <ItemGroup>
    <Content Include="Evals\cases\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
